[Plymouth Theme]
Name=ZumaOS
Description=Boot splash for ZumaOS: wordmark and a slim progress bar
ModuleName=two-step

[two-step]
ImageDir=/usr/share/plymouth/themes/zumaos
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.45
HorizontalAlignment=.5
VerticalAlignment=.7
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.7
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.6
ProgressBarHorizontalAlignment=.5
ProgressBarVerticalAlignment=.58
ProgressBarWidth=180
ProgressBarHeight=4
ProgressBarBackgroundColor=0x2c2c2e
ProgressBarForegroundColor=0xffffff
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x000000
BackgroundEndColor=0x000000
MessageBelowAnimation=true

[boot-up]
UseProgressBar=true
UseAnimation=false
UseEndAnimation=false

[shutdown]
UseProgressBar=false
UseAnimation=true
UseEndAnimation=false

[reboot]
UseProgressBar=false
UseAnimation=true
UseEndAnimation=false

[updates]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Installing updates...
SubTitle=Do not turn off your computer

[system-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Upgrading ZumaOS...
SubTitle=Do not turn off your computer

[firmware-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Upgrading firmware...
SubTitle=Do not turn off your computer
