[Plugins]
blurEnabled=true
contrastEnabled=true
magiclampEnabled=false
squashEnabled=true

[Effect-blur]
BlurStrength=10
NoiseStrength=2

[org.kde.kdecoration2]
library=org.kde.kwin.aurorae
theme=__aurorae__svg__ZumaOS
BorderSize=Normal
BorderSizeAuto=false
# Figma: close, maximise, minimise on the left; nothing on the right (apps
# keep their own hamburger menu in the toolbar).
ButtonsOnLeft=XAI
ButtonsOnRight=

# Alt+Tab shows a grid of window thumbnails.
[TabBox]
LayoutName=thumbnail_grid
