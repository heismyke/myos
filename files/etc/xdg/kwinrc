[Plugins]
blurEnabled=true
contrastEnabled=true
magiclampEnabled=false
squashEnabled=true

[Effect-blur]
BlurStrength=10
NoiseStrength=2

[org.kde.kdecoration2]
library=org.kde.kwin.aurorae
theme=__aurorae__svg__ZumaOS
BorderSize=Normal
BorderSizeAuto=false
ButtonsOnLeft=M
ButtonsOnRight=IAX

# Alt+Tab shows a grid of window thumbnails, as in Windows 11.
[TabBox]
LayoutName=thumbnail_grid
